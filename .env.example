# Canonical public site origin used for metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://usayrat.online

# Firebase Authentication Web API key.
# When this value exists in Vercel, the member account UI is enabled automatically.
FIREBASE_WEB_API_KEY=

# Optional AI Gateway overrides for original news coverage.
# Disabled by default: collection and publishing continue with zero AI calls.
# Enabling this can consume provider credits; opt in explicitly only after setting a hard budget.
AI_GATEWAY_API_KEY=
NEWS_EDITORIAL_MODEL=openai/gpt-5-mini
NEWS_EDITORIAL_AUDIT_MODEL=openai/gpt-5-mini
NEWS_EDITORIAL_MODE=disabled

# Automatic news persistence and scheduled ingestion.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEWS_DATABASE_ENABLED=true
NEWS_INGESTION_BATCH_SIZE=3

# Vercel sends this value as Authorization: Bearer <CRON_SECRET> to the Cron route.
CRON_SECRET=
